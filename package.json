{
  "name": "game-pwa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,convex -c blue.bold,magenta.bold \"vite\" \"convex dev\"",
    "dev:web": "vite",
    "dev:convex": "convex dev",
    "build": "tsc -b && vite build",
